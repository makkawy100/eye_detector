{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚗 Run Eye Detector & Alerter (Webcam)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "📞 Test WhatsApp Voice Call (No Camera)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--test-call"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "✈️ Test Telegram Alert (No Camera)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--test-telegram"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "🧪 Run Unit & Pipeline Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "tests"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
